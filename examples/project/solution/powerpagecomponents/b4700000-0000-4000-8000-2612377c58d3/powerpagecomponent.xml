  <content>{"source":"{% assign demo_can_write = false %}{% if user.roles contains 'Workspace Editors' or user.roles contains 'Administrators' %}{% assign demo_can_write = true %}{% endif %}&lt;div class=\"demo\" data-demo-workspace=\"pcf\" data-demo-can-write=\"{{ demo_can_write }}\"&gt;&lt;p class=\"demo-kicker\"&gt;Approach / 03&lt;/p&gt;&lt;h1&gt;PCF&lt;/h1&gt;&lt;p class=\"demo-lead\"&gt;A custom account workspace with 14 real Power Apps code components. The same portal Web API and permissions save every change.&lt;/p&gt;&lt;nav class=\"demo-pathways\" aria-label=\"Implementation\"&gt;&lt;a href=\"/approach/out-of-the-box/\"&gt;Out of the box&lt;/a&gt;&lt;a href=\"/approach/web-api/\"&gt;Web API&lt;/a&gt;&lt;a href=\"/approach/pcf/\" aria-current=\"page\"&gt;PCF&lt;/a&gt;&lt;/nav&gt;{{ snippets['Demo/Access guidance'] }}&lt;div class=\"demo-status\" data-status role=\"status\" aria-live=\"polite\" hidden&gt;&lt;/div&gt;&lt;section class=\"demo-panel\"&gt;&lt;div class=\"demo-toolbar\"&gt;&lt;form class=\"demo-query\" data-account-query&gt;&lt;label&gt;View&lt;select name=\"view\"&gt;&lt;option value=\"active\"&gt;Active accounts&lt;/option&gt;&lt;option value=\"all\"&gt;All accounts&lt;/option&gt;&lt;option value=\"inactive\"&gt;Inactive accounts&lt;/option&gt;&lt;/select&gt;&lt;/label&gt;&lt;label&gt;Search accounts&lt;input name=\"search\" type=\"search\" placeholder=\"Account name\"&gt;&lt;/label&gt;&lt;button class=\"demo-button secondary\" type=\"submit\"&gt;Search&lt;/button&gt;&lt;/form&gt;&lt;a class=\"demo-button\" href=\"/approach/pcf/account/?mode=create\"&gt;New account&lt;/a&gt;&lt;/div&gt;&lt;div class=\"demo-table-wrap\"&gt;&lt;table aria-label=\"Accounts\"&gt;&lt;thead&gt;&lt;tr&gt;&lt;th&gt;Account&lt;/th&gt;&lt;th&gt;Phone&lt;/th&gt;&lt;th&gt;City&lt;/th&gt;&lt;th&gt;Status&lt;/th&gt;&lt;th&gt;Actions&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody data-account-rows&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;p data-account-empty class=\"demo-empty\" hidden&gt;No accounts match this view. Try All accounts or create an account.&lt;/p&gt;&lt;div class=\"demo-toolbar\" style=\"border:0;margin:18px 0 0;padding:0\"&gt;&lt;p class=\"demo-count\" data-account-count&gt;&lt;/p&gt;&lt;div class=\"demo-actions\"&gt;&lt;button type=\"button\" class=\"demo-button secondary\" data-previous disabled&gt;Previous&lt;/button&gt;&lt;button type=\"button\" class=\"demo-button secondary\" data-next disabled&gt;Next&lt;/button&gt;&lt;/div&gt;&lt;/div&gt;&lt;/section&gt;&lt;div class=\"demo-note\"&gt;Create a test account, open its details, and add a contact. Switch to another approach to see the same saved records.&lt;/div&gt;&lt;dialog class=\"demo-modal\" data-contact-dialog&gt;&lt;div class=\"demo-panel\"&gt;&lt;div class=\"demo-modal-header\"&gt;&lt;h2 data-contact-title&gt;Contact&lt;/h2&gt;&lt;button class=\"demo-modal-close\" type=\"button\" data-close-dialog aria-label=\"Close contact dialog\"&gt;×&lt;/button&gt;&lt;/div&gt;&lt;form data-contact-form&gt;&lt;div class=\"demo-form-grid\"&gt;&lt;label&gt;First name&lt;input name=\"firstname\" autocomplete=\"given-name\"&gt;&lt;/label&gt;&lt;label&gt;Last name &lt;span&gt;Required&lt;/span&gt;&lt;input name=\"lastname\" required autocomplete=\"family-name\"&gt;&lt;/label&gt;&lt;label&gt;Email&lt;input name=\"emailaddress1\" type=\"email\"&gt;&lt;/label&gt;&lt;label&gt;Phone&lt;input name=\"telephone1\" type=\"tel\"&gt;&lt;/label&gt;&lt;label&gt;Job title&lt;input name=\"jobtitle\"&gt;&lt;/label&gt;&lt;label class=\"wide\"&gt;Description&lt;textarea name=\"description\"&gt;&lt;/textarea&gt;&lt;/label&gt;&lt;/div&gt;&lt;p class=\"demo-footnote\"&gt;This contact is linked to the current account when saved.&lt;/p&gt;&lt;div class=\"demo-modal-footer\"&gt;&lt;button class=\"demo-button secondary\" type=\"button\" data-close-dialog&gt;Cancel&lt;/button&gt;&lt;button class=\"demo-button\" type=\"submit\" data-save-contact&gt;Save contact&lt;/button&gt;&lt;/div&gt;&lt;/form&gt;&lt;/div&gt;&lt;/dialog&gt;&lt;dialog class=\"demo-modal\" data-delete-dialog&gt;&lt;div class=\"demo-panel\"&gt;&lt;h2&gt;Delete this record?&lt;/h2&gt;&lt;p&gt;&lt;strong data-delete-name&gt;&lt;/strong&gt; will be deleted from this demo environment.&lt;/p&gt;&lt;div class=\"demo-modal-footer\"&gt;&lt;button type=\"button\" class=\"demo-button secondary\" data-close-dialog&gt;Cancel&lt;/button&gt;&lt;button type=\"button\" class=\"demo-button danger\" data-confirm-delete&gt;Delete record&lt;/button&gt;&lt;/div&gt;&lt;/div&gt;&lt;/dialog&gt;&lt;/div&gt;&lt;script src=\"/demo-workspace.js?v=fb9ac6e3f2c7f\" defer&gt;&lt;/script&gt;"}</content>
