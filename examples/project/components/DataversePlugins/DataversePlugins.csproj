<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <AssemblyName>Paqvilo.Demo.Plugins</AssemblyName>
    <RootNamespace>Paqvilo.Demo.Plugins</RootNamespace>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>PublicDemo.snk</AssemblyOriginatorKeyFile>
    <Deterministic>true</Deterministic>
    <!-- Reproducible with respect to the commit: no commit hash in the version or PDB, so a new commit alone does not
         change the assembly bytes that deployment compares. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <!-- Reproducible with respect to the checkout folder: the PDB path the DLL names is mapped to a fixed root. -->
    <PathMap>$(MSBuildProjectDirectory)=/_/</PathMap>
    <LangVersion>latest</LangVersion>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" Version="9.0.2.60" PrivateAssets="All" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>
</Project>
