  "businessRules": [
    {
      "id": "cdf42a22-0507-4aa3-8662-3a7938dff7d9",
      "table": "pqvd_baselineitem",
      "name": "Baseline hide by flag",
      "scope": "entity",
      "when": {
        "field": "pqvd_flag",
        "equals": false
      },
      "actions": [
        {
          "type": "visibility",
          "field": "pqvd_hiddenbyrule",
          "visible": false
        }
      ],
      "otherwise": [
        {
          "type": "visibility",
          "field": "pqvd_hiddenbyrule",
          "visible": true
        }
      ]
    },
    {
      "id": "8d42a73f-e3a0-4bf1-8940-50242da61ed1",
      "table": "pqvd_baselineitem",
      "name": "Baseline lock by flag",
      "scope": "entity",
      "when": {
        "field": "pqvd_flag",
        "equals": true
      },
      "actions": [
        {
          "type": "lock",
          "field": "pqvd_lockedbyrule",
          "locked": true
        }
      ],
      "otherwise": [
        {
          "type": "lock",
          "field": "pqvd_lockedbyrule",
          "locked": false
        }
      ]
    },
    {
      "id": "6c8ca0b8-222b-4488-884a-6fa1ea94c250",
      "table": "pqvd_baselineitem",
      "name": "Baseline require by text",
      "scope": "entity",
      "when": {
        "field": "pqvd_text",
        "equals": "require"
      },
      "actions": [
        {
          "type": "required",
          "field": "pqvd_requiredbyrule",
          "required": true
        }
      ],
      "otherwise": [
        {
          "type": "required",
          "field": "pqvd_requiredbyrule",
          "required": false
        }
      ]
    },
    {
      "id": "a2b83aea-9197-4e59-8fc7-261b9673d849",
      "table": "pqvd_baselineitem",
      "name": "Baseline default value",
      "scope": "entity",
      "when": {
        "field": "pqvd_defaultbyrule",
        "isNull": true
      },
      "actions": [
        {
          "type": "setDefault",
          "field": "pqvd_defaultbyrule",
          "value": "rule default"
        }
      ]
    },
    {
      "id": "420b3213-6647-4a34-8dbf-0848b8420beb",
      "table": "pqvd_baselineitem",
      "name": "Baseline set value",
      "scope": "entity",
      "when": {
        "field": "pqvd_flag",
        "equals": true
      },
      "guard": {
        "field": "pqvd_setbyrule",
        "notEqual": "set by rule"
      },
      "actions": [
        {
          "type": "setValue",
          "field": "pqvd_setbyrule",
          "value": "set by rule"
        }
      ]
    },
    {
      "id": "24e03a61-ff76-4f60-8e57-b38d8a6d5244",
      "table": "pqvd_baselineitem",
      "name": "Baseline show error",
      "scope": "entity",
      "when": {
        "field": "pqvd_ruleerror",
        "greaterThan": 500
      },
      "actions": [
        {
          "type": "error",
          "field": "pqvd_ruleerror",
          "message": "Rule error must be 500 or less"
        }
      ]
    },
    {
      "id": "0681666e-2049-44fb-8d0f-a619286ca13b",
      "table": "pqvd_baselineitem",
      "name": "Baseline clear value",
      "scope": "entity",
      "when": {
        "field": "pqvd_flag",
        "equals": false
      },
      "guard": {
        "field": "pqvd_setbyrule",
        "notNull": true
      },
      "actions": [
        {
          "type": "clearValue",
          "field": "pqvd_setbyrule"
        }
      ]
    },
    {
      "id": "936fe4a4-93ed-44a6-8c1e-bbbcd0b9b39e",
      "table": "pqvd_baselineitem",
      "name": "Baseline all forms scope",
      "scope": "all-forms",
      "when": {
        "field": "pqvd_text",
        "equals": "all-forms"
      },
      "actions": [
        {
          "type": "required",
          "field": "pqvd_recommended",
          "required": true
        }
      ]
    },
    {
      "id": "6e7ade5f-551e-45c9-830c-aa6e9d8bf702",
      "table": "pqvd_baselineitem",
      "name": "Baseline form scope",
      "scope": "form",
      "formId": "bf599af2-f636-414f-8a8d-05a4306b92ac",
      "when": {
        "field": "pqvd_text",
        "equals": "form-scope"
      },
      "actions": [
        {
          "type": "visibility",
          "field": "pqvd_recommended",
          "visible": false
        }
      ]
    }
  ],
