{
  "name": "paqvilo",
  "version": "0.9.8",
  "description": "Local-first, pro-code tools for Microsoft Power Pages: live source previews with Lense, Liquid and Dataverse simulation with Mirage.",
  "keywords": [
    "power-pages",
    "power-platform",
    "pro-code",
    "local-first",
    "dataverse",
    "liquid",
    "developer-tools",
    "local-development",
    "simulation",
    "testing"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maksii/paqvilo.git"
  },
  "homepage": "https://maksii.github.io/paqvilo/",
  "bugs": {
    "url": "https://github.com/maksii/paqvilo/issues"
  },
  "private": false,
  "files": [
    "bin/",
    "lense/",
    "mirage/*.mjs",
    "mirage/lib/",
    "mirage/admin/",
    "mirage/testing/",
    "mirage/package.json",
    "mirage/package-lock.json",
    "mirage/README.md",
    "mirage/docs/",
    "scripts/ensure-dependencies.mjs",
    "paqvilo.config.yml",
    ".env.example",
    "AGENTS.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "NOTICE",
    "licenses/",
    "docs/",
    "examples/",
    "templates/",
    "npm-shrinkwrap.json"
  ],
  "type": "module",
  "bin": {
    "paqvilo": "bin/paqvilo.mjs"
  },
  "scripts": {
    "setup": "node scripts/ensure-dependencies.mjs",
    "setup:repo": "npm run ci:prepare -- --quality && npm run cache:package && npm run hooks:install",
    "cache:package": "node scripts/prime-package-cache.mjs",
    "hooks:install": "node scripts/git-hooks.mjs install",
    "hooks:check": "node scripts/git-hooks.mjs pre-commit",
    "check:contribution": "node scripts/conventional-commit.mjs --title",
    "site:build": "node scripts/build-site.mjs",
    "dev": "node bin/paqvilo.mjs lense dev",
    "dev:pick": "node bin/paqvilo.mjs lense dev --pick",
    "list": "node bin/paqvilo.mjs lense list",
    "use": "node bin/paqvilo.mjs lense use",
    "map": "node bin/paqvilo.mjs lense map",
    "status": "node bin/paqvilo.mjs lense status",
    "verify": "node bin/paqvilo.mjs lense verify",
    "doctor": "node bin/paqvilo.mjs lense doctor",
    "audit:resources": "node bin/paqvilo.mjs lense audit",
    "resources": "node bin/paqvilo.mjs lense resources",
    "mirage": "node bin/paqvilo.mjs mirage",
    "dataverse": "node bin/paqvilo.mjs dataverse",
    "agent": "node bin/paqvilo.mjs lense agent",
    "benchmark": "node scripts/benchmark.mjs",
    "test": "node --test --test-concurrency=4 --test-timeout=180000 test/*.test.mjs",
    "test:browser": "node --test --import=./test/browser-bootstrap.mjs --test-concurrency=2 --test-timeout=300000 test-browser/*.test.mjs",
    "test:example": "npm install --prefix examples/project --offline --ignore-scripts --no-audit --no-fund --package-lock=false && node --test --test-timeout=180000 examples/project/test/baseline-*.test.mjs examples/project/test/portal.test.mjs examples/project/test/plugins.test.mjs",
    "test:example:browser": "node --test --import=./test/browser-bootstrap.mjs --test-concurrency=2 --test-timeout=300000 examples/project/test/*-browser.test.mjs",
    "test:company": "npm ci --prefix examples/company-operations --offline --ignore-scripts --no-audit --no-fund && npm --prefix examples/company-operations test",
    "test:company:browser": "node test/browser-bootstrap.mjs --npm --prefix examples/company-operations run test:browser",
    "check": "node scripts/check.mjs && npm run check:boundary",
    "check:test-tags": "node scripts/check-test-tags.mjs",
    "validate": "node scripts/ci.mjs verify --full",
    "release:check": "node scripts/release-check.mjs",
    "preview:cleanup": "node scripts/preview-retention.mjs",
    "release:smoke": "node scripts/package-smoke.mjs",
    "ci:evidence": "node scripts/collect-evidence.mjs",
    "demo": "node scripts/demo.mjs",
    "demo:evidence": "node scripts/demo.mjs --evidence",
    "lense": "node bin/paqvilo.mjs lense",
    "check:boundary": "node scripts/project-boundary.mjs",
    "test:sdk": "node --test --test-timeout=600000 mirage/test-sdk/toolkit-client/gate.test.mjs mirage/test-sdk/python-dataverse/gate.test.mjs mirage/test-sdk/webapi-samples/gate.test.mjs mirage/test-sdk/serviceclient/gate.test.mjs && npm --prefix mirage/test-sdk/dynamics-web-api test && npm --prefix mirage/test-sdk/cert-auth test && npm --prefix mirage/test-sdk/tds test",
    "lint": "eslint --config eslint.config.mjs . --max-warnings=0",
    "lint:fix": "eslint --config eslint.config.mjs . --fix --max-warnings=0",
    "format": "node scripts/format.mjs",
    "format:check": "prettier . --check",
    "quality": "npm run format:check && npm run lint && npm run check:workflows && npm run review:code",
    "ci:prepare": "node scripts/ci.mjs prepare",
    "ci:verify": "node scripts/ci.mjs verify",
    "check:workflows": "node scripts/check-workflows.mjs",
    "check:pr": "node scripts/pr-readiness.mjs",
    "audit:dependencies": "node scripts/audit-dependencies.mjs",
    "hooks:push": "node scripts/git-hooks.mjs pre-push",
    "review:code": "node scripts/generate-compat-watchers.mjs --check && node scripts/code-review.mjs --check",
    "ci:sdk:prepare": "node scripts/ci.mjs sdk-prepare",
    "ci:sdk": "node scripts/ci.mjs sdk"
  },
  "engines": {
    "node": "^24.22.1"
  },
  "dependencies": {
    "chokidar": "6.0.0",
    "dompurify": "3.4.17",
    "jquery": "3.7.1",
    "moment": "2.31.0",
    "parse5": "8.0.1",
    "pixelmatch": "8.0.0",
    "playwright-core": "1.64.1",
    "pngjs": "7.0.0",
    "sanitize-html": "2.18.1",
    "yaml": "2.9.1"
  },
  "license": "AGPL-3.0-only",
  "exports": {
    "./mirage": "./mirage/api.mjs",
    "./mirage/acceptance": "./mirage/acceptance-api.mjs",
    "./mirage/testing": "./mirage/testing.mjs",
    "./mirage/code-apps": "./mirage/lib/code-apps-sdk.js",
    "./mirage/code-apps/vite": {
      "types": "./mirage/lib/code-apps-vite.d.ts",
      "default": "./mirage/lib/code-apps-vite.mjs"
    },
    "./mirage/code-apps/client": {
      "types": "./mirage/lib/code-apps-client.d.ts",
      "default": "./mirage/lib/code-apps-client.js"
    },
    "./mirage/packs": "./mirage/packs.mjs",
    "./mirage/fixtures": "./mirage/fixtures.mjs",
    "./lense": "./lense/api.mjs",
    "./dataverse": "./lense/dataverse/index.mjs",
    "./package.json": "./package.json",
    "./lense/*": "./lense/*",
    "./mirage/*": "./mirage/*"
  },
  "packageManager": "npm@11.19.1",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@microsoft/power-apps": "1.5.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-n": "18.5.0",
    "globals": "17.13.0",
    "jscpd": "5.4.2",
    "knip": "6.43.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "7.3.7"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.1",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "11.19.1",
      "onFail": "error"
    }
  }
}
